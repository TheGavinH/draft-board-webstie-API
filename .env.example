# Copy this to .env for local dev (don't commit the real .env).

# Leave unset to use a local SQLite file. In production, point this at a
# hosted Postgres database — Neon (neon.tech) and Supabase both have free tiers
# that work well with a small API like this.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required for POST/PUT/DELETE to work. Pick any long random string.
ADMIN_TOKEN=change-me-to-something-long-and-random

# Comma-separated list of sites allowed to call this API. Set this to your
# real site's URL once it's deployed (e.g. https://your-site.netlify.app).
# Leave as * while you're just testing locally.
ALLOWED_ORIGINS=*

# Shown on the Draft Big Board page.
BOARD_LABEL=Gavin's NFL Draft Big Board
